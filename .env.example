JWT_SECRET=change-me-to-a-random-secret-string
DATA_DIR=/data
NODE_ENV=production
PORT=8080
NEXTAUTH_URL=https://your-railway-domain.up.railway.app

# Facebook / Meta Ads OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google OAuth (Ads + Search Console + GA4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GA4_PROPERTY_ID=

# TikTok Ads OAuth
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# LinkedIn Ads OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Article Writer
ANTHROPIC_API_KEY=
SERPER_API_KEY=
WP_BEAUTY_URL=https://nationalsalonsupplies.com.au/beauty
WP_BEAUTY_USER=
WP_BEAUTY_APP_PASSWORD=
WP_MAIN_URL=https://nationalsalonsupplies.com.au
WP_MAIN_USER=
WP_MAIN_APP_PASSWORD=

# SEO tools (SEO -> Rank Tracker / Site Audit / Keyword Research / Backlink Profile)
# DataForSEO can be set here or, per deployment, under Admin -> Connections (that wins).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# The site this deployment is about, to prefill the SEO tools. Only needed when neither
# Search Console nor the store URL is set under Connections.
SITE_DOMAIN=
# Lets a scheduler run rank checks: POST /api/seo/rank {"action":"check"} with header x-cron-key.
# Unset = scheduled checks are off.
SEO_CRON_KEY=
